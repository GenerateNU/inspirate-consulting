# Copy to /opt/inspirate-consulting/preview.env on the droplet (chmod 600).
#
# Shared by every PR preview container. Only the per-PR database name and
# hostname differ, and those are passed as arguments by preview-up.sh -- which
# is why these secrets can live in a file on the droplet instead of crossing
# the wire on every deploy.

ENVIRONMENT=preview
PORT=8080

# Preview Postgres lives on this droplet, on the `edge` network. Plaintext is
# fine: the traffic never leaves the Docker bridge, and the database holds
# nothing but throwaway data.
DB_HOST=preview-db
DB_PORT=5432
DB_USER=postgres
# Must match PREVIEW_DB_PASSWORD in /opt/shared/.env exactly.
DB_PASSWORD=
DB_SSLMODE=disable

# Auth still comes from Supabase. Use the PREVIEW Supabase project, never
# production -- a preview should not be able to mint production sessions.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Read directly by auth.NewVerifier (os.Getenv), not via the config struct --
# so the app boots without it and then 401s every authenticated request.
# Supabase -> Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# S3 video uploads. Point these at a NON-PRODUCTION bucket: previews should
# not be able to write to real user media.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME has a default in the backend config; set it to override.
