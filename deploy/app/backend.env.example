# Copy to /opt/inspirate-consulting/backend.env on the droplet (chmod 600).
# Production configuration: data and auth both come from Supabase.

ENVIRONMENT=production
PORT=8080

# The Netlify site that serves the frontend.
PUBLIC_FRONTEND_URL=https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,https://cdn.scalar.com
ALLOWED_ORIGINS=https://your-site.netlify.app
FRONTEND_URL=https://your-site.netlify.app

# Supabase production database.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Read directly by auth.NewVerifier (os.Getenv), not via the config struct --
# so the app boots without it and then 401s every authenticated request.
# Supabase -> Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# S3 video uploads. The droplet has no IAM role, so credentials must be
# explicit -- the same three the backend CI workflow sets.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME has a default in the backend config; set it to override.
