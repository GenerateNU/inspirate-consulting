# Copy to deploy/shared/.env on the droplet (chmod 600).

# Let's Encrypt expiry notifications.
ACME_EMAIL=infra@example.org

# Superuser password for the preview-only Postgres. Generate with:
#   openssl rand -hex 32
# Use hex, not base64: this value is interpolated into a postgres:// URL when
# migrations run, and base64's "/" and "+" would corrupt it.
# It guards throwaway preview data, but it is still a real credential -- the
# container is reachable by anything on the `edge` network.
PREVIEW_DB_PASSWORD=
