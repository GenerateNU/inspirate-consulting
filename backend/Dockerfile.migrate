# Applies the Supabase migrations to whatever Postgres DATABASE_URL points at.
#
# Used for PR previews on the droplet, where each pull request gets its own
# database. Run as a one-off container before the backend starts, so a failed
# migration fails the preview rather than leaving the app on an old schema.
#
# Production migrations are applied by hand against Supabase (make db-push).
#
# Debian rather than Alpine on purpose: the Supabase CLI is dynamically linked
# against glibc, so on musl it fails with a bare "supabase: not found" that
# looks like the binary is missing rather than unrunnable.
FROM debian:bookworm-slim

# Pinned so a preview cannot start failing because upstream cut a release.
ARG SUPABASE_CLI_VERSION=2.117.0

# Set by BuildKit (amd64 on CI and the droplet, arm64 on an Apple Silicon Mac).
# Hardcoding amd64 builds an image half the team cannot run locally.
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL -o /tmp/supabase.tar.gz \
      "https://github.com/supabase/cli/releases/download/v${SUPABASE_CLI_VERSION}/supabase_${SUPABASE_CLI_VERSION}_linux_${TARGETARCH}.tar.gz" \
 && tar -xzf /tmp/supabase.tar.gz -C /usr/local/bin supabase \
 && rm /tmp/supabase.tar.gz \
 && apt-get purge -y curl \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* \
 && supabase --version

WORKDIR /app

# The CLI expects ./supabase/config.toml and ./supabase/migrations relative to
# the working directory, which is why this is not copied in flat.
COPY internal/supabase/ ./supabase/

# --include-all lets a PR branched before a recently-added migration still
# apply out-of-order history instead of aborting.
CMD ["sh", "-c", "supabase db push --db-url \"$DATABASE_URL\" --include-all --yes"]
