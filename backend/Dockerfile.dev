FROM golang:1.25-alpine

# air watches the source tree and rebuilds/restarts on change
RUN go install github.com/air-verse/air@v1.67.0

# Set the working directory (this is /backend in inspirate-consulting)
WORKDIR /app

# Copy only go.mod and go.sum first (to cache dependencies)
COPY go.mod go.sum ./
RUN go mod download

CMD ["air", "-c", ".air.toml"]
